{
  "name": "small-desktop-display-remote-render",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:console",
    "build:server": "tsc -p tsconfig.json",
    "build:console": "vite build",
    "dev:console": "vite",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.console.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "start": "node dist/main.js",
    "preview": "node dist/tools/frame-preview.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@tanstack/react-query": "5.102.0",
    "lucide-react": "1.33.0",
    "motion": "13.1.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-reconciler": "0.33.0",
    "serialport": "12.0.0",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.5"
  }
}
